# Copy to .env and fill in.  cp .env.example .env
#
# Every variable here is validated at import time by src/shared/config/env.ts,
# which means `npm run build` fails on a missing or malformed value — not the
# server at boot. Set these before building on a deploy host.

# ── Core (required) ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://openclass:openclass@localhost:5433/openclass?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with: openssl rand -base64 32"
QR_SECRET="generate-with: openssl rand -base64 32"

# ── Web push (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_PRIVATE_KEY="generate-with: npx web-push generate-vapid-keys"
VAPID_SUBJECT="mailto:you@example.com"

# ── Registration ─────────────────────────────────────────────────────────────
# Set to "true" to allow new account registration. Omit or set to anything else to disable.
REGISTRATION_ENABLED=false

# ── Recorded courses / video pipeline ────────────────────────────────────────
# Private media root holding original uploads and generated HLS.
# MUST be outside public/ — anything under public/ is served statically by
# Next.js, which would expose the original video files. Point this at
# persistent storage in production (e.g. /var/lib/openclass/media) and make
# sure the app user can write to it.
MEDIA_ROOT="./storage/media"

# Signing key for short-lived playback tokens. Falls back to AUTH_SECRET when
# omitted; set it explicitly so rotating one does not invalidate the other.
VIDEO_SECRET="generate-with: openssl rand -base64 32"

# FFmpeg + FFprobe must be installed on any node where VIDEO_WORKER_ENABLED is
# not "false". Absolute paths are fine if they are not on PATH.
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Ceiling for a single uploaded video. Default 2 GiB.
MAX_VIDEO_UPLOAD_BYTES=2147483648

# Lifetime of a playback authorization, in seconds. Keep it short — it is the
# window in which a copied stream URL still works. Default 300 (5 minutes).
PLAYBACK_TOKEN_TTL_SECONDS=300

# Percentage of a lesson that marks it complete. Default 92.
LESSON_COMPLETION_THRESHOLD=92

# Set to "false" on nodes that serve web traffic but should not transcode
# (transcoding is CPU-heavy). At least one node must have it enabled.
VIDEO_WORKER_ENABLED=true
